# model.env — active model configuration
# Edit these lines to switch models; source before running classify.py or submitting jobs.
#
# Local:  source model.env && python classify.py ...
# HPC:    sourced automatically by hpc/run_classify.pbs and hpc/run_smoke_test.pbs

MODEL="Qwen/Qwen3.6-27B-FP8"
MODEL_LABEL="qwen36_27b_fp8"     # suffix for output columns: is_mental_health_qwen36_27b_fp8
QUANTIZATION=""                  # '' if pre-quantised; 'fp8' for on-the-fly quantisation
LANGUAGE_MODEL_ONLY=true         # true for multimodal architectures run text-only
DISABLE_THINKING=true            # true for Qwen3.x reasoning models

