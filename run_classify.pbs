#!/bin/bash
# Full classification job — run run_test.pbs first to verify the pipeline.
#
# Submit:
#   qsub run_classify.pbs
#   qstat -u $USER

#PBS -N tiktok_classify
#PBS -l walltime=02:00:00
#PBS -l select=1:ncpus=8:mem=48gb:ngpus=1
#PBS -q v1_gpu72
#PBS -o logs/
#PBS -e logs/

MODEL="google/gemma-4-26B-A4B-it"   # Must match the MODEL variable in run_*.pbs
INPUT="sample_1000.parquet"

module load miniforge/3
eval "$(~/miniforge3/bin/conda shell.bash hook)"
conda activate tiktok

export HF_HOME=$EPHEMERAL/huggingface
cd $PBS_O_WORKDIR
mkdir -p logs

echo "=== Job started: $(date) ==="
echo "Node:  $(hostname)"
echo "GPU:   $(nvidia-smi --query-gpu=name,memory.total --format=csv,noheader 2>/dev/null)"
echo "Input: $INPUT"
echo ""

export CUDA_VISIBLE_DEVICES=0

vllm serve "$MODEL" \
    --port 8000 \
    --max-model-len 4096 \
    --max-num-batched-tokens 4096 \
    --quantization fp8 \
    --gpu-memory-utilization 0.90 \
    > logs/vllm_test.log 2> logs/vllm_test.err &
VLLM_PID=$!

echo "Waiting for vLLM..."
WAIT=0
until curl -sf http://localhost:8000/health > /dev/null 2>&1; do
    sleep 10; WAIT=$((WAIT+10))
    if [ $WAIT -ge 300 ]; then
        echo "ERROR: vLLM failed to start. See logs/vllm.log"
        kill $VLLM_PID 2>/dev/null; exit 1
    fi
done
echo "vLLM ready after ${WAIT}s."

echo ""
echo "=== Pass 1: screen ($(date)) ==="
python 02_classify.py "$INPUT" \
    --stage screen --backend vllm --model "$MODEL" --concurrency 16 -v

echo ""
echo "=== Pass 2: classify ($(date)) ==="
python 02_classify.py "$INPUT" \
    --stage classify \
    --filter is_mental_health_broad=TRUE \
    --rationale \
    --backend vllm --model "$MODEL" --concurrency 8 -v

kill $VLLM_PID 2>/dev/null
echo ""
echo "=== Job finished: $(date) ==="
