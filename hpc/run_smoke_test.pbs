#!/bin/bash
# Smoke/scale test — screen + classify on a small slice of the master parquet.
# Results go to metadata/test_${ROWS}.parquet (existing model columns are dropped
# so each run reclassifies from scratch).
#
# Submit:
#   qsub hpc/run_smoke_test.pbs               # 20-row smoke test (default)
#   qsub -v ROWS=1000 hpc/run_smoke_test.pbs  # 1000-row scale test
#
# Check output:
#   cat logs/tiktok_test.o*    # stdout (classification results)
#   cat logs/tiktok_test.e*    # stderr (errors)
#   cat logs/vllm_test.log     # vLLM server log

#PBS -N tiktok_test
#PBS -l walltime=00:30:00
#PBS -l select=1:ncpus=4:mem=48gb:ngpus=1
#PBS -q v1_gpu72
#PBS -o logs/
#PBS -e logs/

ROWS="${ROWS:-20}"
MASTER="metadata/data.parquet"

module load miniforge/3
eval "$(~/miniforge3/bin/conda shell.bash hook)"
conda activate tiktok

export HF_HOME=$HOME/huggingface
cd $PBS_O_WORKDIR
mkdir -p logs

. model.env       # MODEL, MODEL_LABEL, QUANTIZATION, LANGUAGE_MODEL_ONLY, DISABLE_THINKING
. hpc/config.sh   # VLLM_PORT, vllm_start(), vllm_wait()

echo "=== Test job started: $(date) ==="
echo "Node: $(hostname)"
echo "GPU:  $(nvidia-smi --query-gpu=name,memory.total --format=csv,noheader 2>/dev/null)"
echo "Rows: $ROWS"
echo ""

TESTFILE="metadata/test_${ROWS}.parquet"
python - "$ROWS" "$MODEL_LABEL" "$MASTER" "$TESTFILE" <<PYEOF
import pandas as pd, sys
rows, label, src, dst = int(sys.argv[1]), sys.argv[2], sys.argv[3], sys.argv[4]
df = pd.read_parquet(src).head(rows)
cols_to_drop = [c for c in df.columns if label in c]
if cols_to_drop:
    df = df.drop(columns=cols_to_drop)
    print(f"Dropped {len(cols_to_drop)} existing {label} column(s)")
df.to_parquet(dst, index=False)
print(f"Created {dst} ({rows} rows from {src})")
PYEOF

module load CUDA/12.8.0
# export VLLM_LOGGING_LEVEL=DEBUG
export CUDA_VISIBLE_DEVICES=0

vllm_start logs/vllm_test.log logs/vllm_test.err
VLLM_PID=$!

if ! vllm_wait; then
    kill $VLLM_PID 2>/dev/null; exit 1
fi

echo ""
echo "=== Screen pass ==="
python classify.py "$TESTFILE" \
    --stage screen --backend vllm --model "$MODEL" \
    --model-label "$MODEL_LABEL" --concurrency 4 -v

echo ""
echo "=== Classify pass ==="
python classify.py "$TESTFILE" \
    --stage classify \
    --filter "is_mental_health_broad_${MODEL_LABEL}=TRUE" \
    --rationale \
    --backend vllm --model "$MODEL" \
    --model-label "$MODEL_LABEL" --concurrency 2 -v

echo ""
python - "$MODEL_LABEL" "$TESTFILE" <<PYEOF
import pandas as pd, sys
label, path = sys.argv[1], sys.argv[2]
broad_col = f"is_mental_health_broad_{label}" if label else "is_mental_health_broad"
mh_col    = f"is_mental_health_{label}"        if label else "is_mental_health"
rat_col   = f"{mh_col}_rationale"
df = pd.read_parquet(path)
cols = [c for c in ['url', broad_col, mh_col, rat_col] if c in df.columns]
print('Results:')
print(df[cols].to_string())
PYEOF

kill $VLLM_PID 2>/dev/null
echo ""
echo "=== Test job finished: $(date) ==="
