#!/bin/bash
# Production classify job — screen + classify on the full metadata parquet.
# Atomic resume: if the job hits the 24h walltime, just resubmit —
# classify.py skips rows that already have a non-null result column.
#
# Submit:
#   qsub hpc/run_classify.pbs
#   qsub -v INPUT=metadata/other.parquet hpc/run_classify.pbs   # different input

#PBS -N tiktok_classify
#PBS -l walltime=24:00:00
#PBS -l select=1:ncpus=8:mem=48gb:ngpus=1
#PBS -q v1_gpu72
#PBS -o logs/
#PBS -e logs/

INPUT="${INPUT:-metadata/data.parquet}"

module load miniforge/3
eval "$(~/miniforge3/bin/conda shell.bash hook)"
conda activate tiktok

export HF_HOME=$HOME/huggingface
cd $PBS_O_WORKDIR
mkdir -p logs

. model.env       # MODEL, MODEL_LABEL, QUANTIZATION, LANGUAGE_MODEL_ONLY, DISABLE_THINKING
. hpc/config.sh   # VLLM_PORT, vllm_start(), vllm_wait()

echo "=== Job started: $(date) ==="
echo "Node:  $(hostname)"
echo "GPU:   $(nvidia-smi --query-gpu=name,memory.total --format=csv,noheader 2>/dev/null)"
echo "Input: $INPUT"
echo ""

module load CUDA/12.8.0
# export VLLM_LOGGING_LEVEL=DEBUG
export CUDA_VISIBLE_DEVICES=0

vllm_start logs/vllm.log logs/vllm.err
VLLM_PID=$!

if ! vllm_wait; then
    kill $VLLM_PID 2>/dev/null; exit 1
fi

echo ""
echo "=== Pass 1: screen ($(date)) ==="
python classify.py "$INPUT" \
    --stage screen --backend vllm --concurrency 16 -v

echo ""
echo "=== Pass 2: classify ($(date)) ==="
python classify.py "$INPUT" \
    --stage classify --rationale \
    --backend vllm --concurrency 8 -v

kill $VLLM_PID 2>/dev/null
echo ""
echo "=== Job finished: $(date) ==="
