#!/bin/bash
# Small test job — run this before run_batch.pbs to verify the pipeline.
# Uses the first 20 rows of sample_1000.parquet.
#
# Submit:
#   qsub run_test.pbs
#   qstat -u $USER
#
# Check output:
#   cat logs/tiktok_test.o*    # stdout (classification results)
#   cat logs/tiktok_test.e*    # stderr (errors)
#   cat logs/vllm_test.log     # vLLM server log
#   python -c "import pandas as pd; df = pd.read_parquet('metadata/test_20.parquet'); print(df[[c for c in df.columns if 'mental_health' in c or c == 'url']].to_string())"

#PBS -N tiktok_test
#PBS -l walltime=00:30:00
#PBS -l select=1:ncpus=4:mem=48gb:ngpus=1
#PBS -q v1_gpu72
#PBS -o logs/
#PBS -e logs/

module load miniforge/3
eval "$(~/miniforge3/bin/conda shell.bash hook)"
conda activate tiktok

export HF_HOME=$HOME/huggingface
cd $PBS_O_WORKDIR
mkdir -p logs

. ./config.sh   # MODEL, VLLM_PORT, vllm_start(), vllm_wait()

echo "=== Test job started: $(date) ==="
echo "Node: $(hostname)"
echo "GPU:  $(nvidia-smi --query-gpu=name,memory.total --format=csv,noheader 2>/dev/null)"
echo ""

# Create test_20.parquet from sample_1000.parquet if it doesn't exist
python -c "
import pandas as pd, os
if not os.path.exists('metadata/test_20.parquet'):
    df = pd.read_parquet('metadata/sample_1000.parquet').head(20)
    df.to_parquet('metadata/test_20.parquet', index=False)
    print('Created metadata/test_20.parquet (20 rows)')
else:
    print('metadata/test_20.parquet already exists')
"

module load CUDA/12.8.0
# export VLLM_LOGGING_LEVEL=DEBUG
export CUDA_VISIBLE_DEVICES=0

vllm_start logs/vllm_test.log logs/vllm_test.err
VLLM_PID=$!

if ! vllm_wait; then
    kill $VLLM_PID 2>/dev/null; exit 1
fi

echo ""
echo "=== Screen pass ==="
python 02_classify.py metadata/test_20.parquet \
    --stage screen --backend vllm --model "$MODEL" \
    --model-label "$MODEL_LABEL" --concurrency 4 -v

echo ""
echo "=== Classify pass ==="
python 02_classify.py metadata/test_20.parquet \
    --stage classify \
    --filter "is_mental_health_broad_${MODEL_LABEL}=TRUE" \
    --rationale \
    --backend vllm --model "$MODEL" \
    --model-label "$MODEL_LABEL" --concurrency 2 -v

echo ""
python - <<PYEOF
import pandas as pd, os
label = os.environ.get("MODEL_LABEL", "")
broad_col = f"is_mental_health_broad_{label}" if label else "is_mental_health_broad"
mh_col    = f"is_mental_health_{label}"        if label else "is_mental_health"
rat_col   = f"{mh_col}_rationale"
df = pd.read_parquet('metadata/test_20.parquet')
cols = [c for c in ['url', broad_col, mh_col, rat_col] if c in df.columns]
print('Results:')
print(df[cols].to_string())
PYEOF

kill $VLLM_PID 2>/dev/null
echo ""
echo "=== Test job finished: $(date) ==="
